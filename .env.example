# GEMINI_API_KEY: Required only if Gemini AI features are enabled.
GEMINI_API_KEY=""

# APP_URL: Public base URL of the running application (auto-injected in Cloud Run).
APP_URL="http://localhost:3000"

# SUPABASE SERVER CONFIGURATION (Never expose SUPABASE_SERVICE_ROLE_KEY to the browser)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE CLIENT CONFIGURATION (Public anon key only, safe for Vite client bundle)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# PAYMENT ENVIRONMENT SAFETY GATES
# Keep PAYMENT_LIVE_ENABLED="false" and PESEPAY_ENV="sandbox" until merchant onboarding & provider approval are complete.
PAYMENT_LIVE_ENABLED="false"
PESEPAY_ENV="sandbox"
PESEPAY_SPLIT_REFUNDS_VERIFIED="false"

# PESEPAY SERVER-ONLY CREDENTIALS (From Pesepay Merchant Control Panel)
PESEPAY_INTEGRATION_KEY=""
PESEPAY_ENCRYPTION_KEY=""
PESEPAY_RESULT_URL=""
PESEPAY_RETURN_URL=""

# ALTERNATIVE PROVIDER ADAPTER: PAYONIFY RELAY (Future adapter scaffolding)
PAYONIFY_API_KEY=""
PAYONIFY_RELAY_BASE_URL=""

# TRANSEND TOURS (PRIVATE) LIMITED — CONFIGURABLE COMPANY DETAILS (Leave blank until verified)
COMPANY_REGISTRATION_NUMBER=""
COMPANY_TAX_NUMBER=""
COMPANY_SUPPORT_EMAIL=""
COMPANY_SUPPORT_PHONE=""
COMPANY_REGISTERED_ADDRESS=""
